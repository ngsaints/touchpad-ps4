<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Touchpad PS4" Width="1380" Height="900" MinWidth="1050" MinHeight="720"
 WindowState="Maximized" WindowStartupLocation="CenterScreen" Background="#101725" Foreground="#F4F7FF" FontFamily="Segoe UI" FontSize="14">
 <Window.Resources>
  <SolidColorBrush x:Key="Muted" Color="#99ABC0" />
  <LinearGradientBrush x:Key="Glass" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#C026364B" Offset="0"/><GradientStop Color="#A0182335" Offset="1"/></LinearGradientBrush>
  <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap" /></Style>
  <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="{StaticResource Glass}"/><Setter Property="BorderBrush" Value="#22D5E9FF"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="22"/><Setter Property="Padding" Value="24"/></Style>
  <Style TargetType="Button">
   <Setter Property="Foreground" Value="#DBE8F8"/><Setter Property="Background" Value="#293B51"/><Setter Property="Padding" Value="18,11"/><Setter Property="Cursor" Value="Hand"/><Setter Property="BorderThickness" Value="0"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" CornerRadius="11" Padding="{TemplateBinding Padding}" BorderBrush="#28C8E9FF" BorderThickness="1"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.8"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="CheckBox">
   <Setter Property="Foreground" Value="#DCE6F3"/><Setter Property="Cursor" Value="Hand"/><Setter Property="VerticalContentAlignment" Value="Center"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><Grid Margin="0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="48"/></Grid.ColumnDefinitions><ContentPresenter VerticalAlignment="Center"/><Border x:Name="Track" Grid.Column="1" Background="#42516A" Width="44" Height="24" CornerRadius="12"><Ellipse x:Name="Thumb" Width="18" Height="18" Fill="#EDF6FF" HorizontalAlignment="Left" Margin="3"/></Border></Grid><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Track" Property="Background" Value="#4FD1C5"/><Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/><Setter TargetName="Thumb" Property="Fill" Value="#10252B"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="Slider"><Setter Property="Margin" Value="-3,12,-3,4"/><Setter Property="Foreground" Value="#72E9DB"/><Setter Property="IsSnapToTickEnabled" Value="True"/><Setter Property="AutoToolTipPlacement" Value="TopLeft"/></Style>
 </Window.Resources>
 <Grid>
  <Grid.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#152639" Offset="0"/><GradientStop Color="#101725" Offset="0.5"/><GradientStop Color="#26203B" Offset="1"/></LinearGradientBrush></Grid.Background>
  <Grid.ColumnDefinitions><ColumnDefinition Width="224"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Ellipse Grid.Column="1" Fill="#204D6470" Width="650" Height="650" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,-250,0,0"><Ellipse.Effect><BlurEffect Radius="100"/></Ellipse.Effect></Ellipse>
  <Border Background="#80101928" BorderBrush="#15D5E9FF" BorderThickness="0,0,1,0" Padding="24,32,20,24">
   <DockPanel LastChildFill="True">
    <StackPanel DockPanel.Dock="Top">
     <Border Background="#193E49" BorderBrush="#4072E9DB" BorderThickness="1" Width="46" Height="46" CornerRadius="14" HorizontalAlignment="Left"><TextBlock Text="&#xE7FC;" FontFamily="Segoe MDL2 Assets" FontSize="23" Foreground="#85EFE1" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
     <TextBlock Text="Touchpad PS4" FontSize="21" FontWeight="SemiBold" Margin="0,18,0,3"/>
     <TextBlock Text="Seu controle, além do jogo." FontSize="12" Foreground="{StaticResource Muted}"/>
     <Border Background="#203EBFB4" CornerRadius="10" Padding="13" Margin="0,38,0,8"><TextBlock Text="&#xE80F;   Visão geral" FontFamily="Segoe UI" Foreground="#90F0E2" FontWeight="SemiBold"/></Border>
     <TextBlock Text="MOVIMENTO E GESTOS" FontSize="10" Foreground="#71869E" Margin="12,18,0,12"/>
     <TextBlock Text="Ajuste tudo nesta janela." Foreground="{StaticResource Muted}" FontSize="12" Margin="12,0,0,0"/>
    </StackPanel>
    <StackPanel DockPanel.Dock="Bottom">
     <Border Style="{StaticResource Card}" Padding="14" CornerRadius="14"><StackPanel><TextBlock Text="Ctrl + Alt + M" FontWeight="SemiBold" Foreground="#91F3E4"/><TextBlock Text="Ative ou pause de qualquer janela." FontSize="12" Foreground="{StaticResource Muted}" Margin="0,6,0,0"/></StackPanel></Border>
     <TextBlock Text="WINDOWS DESKTOP  /  v1.1" Foreground="#6E8098" FontSize="9" Margin="2,20,0,0"/>
    </StackPanel>
    <Grid/>
   </DockPanel>
  </Border>
  <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <StackPanel MaxWidth="1460" Margin="34,30,34,26">
    <Grid Margin="0,0,0,24"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel><TextBlock Text="SEU ESPAÇO DE CONTROLE" FontSize="10" Foreground="#80DCCF"/><TextBlock Text="Pequenos gestos. Grandes movimentos." FontSize="29" FontWeight="SemiBold" Margin="0,7,16,7"/><TextBlock Text="Transforme o touchpad do seu DualShock 4 em uma extensão do Windows." Foreground="{StaticResource Muted}" FontSize="13"/></StackPanel>
     <Button Name="HideButton" Grid.Column="1" Content="&#xE921;   Ocultar na bandeja" VerticalAlignment="Top" Margin="0,8,0,0"/>
    </Grid>
    <Grid>
     <Grid.ColumnDefinitions><ColumnDefinition Width="1.35*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*" MinWidth="330"/></Grid.ColumnDefinitions>
     <StackPanel>
      <Border Style="{StaticResource Card}" Padding="28,22,28,22">
       <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid><TextBlock Text="DUALSHOCK 4" FontSize="11" Foreground="#B6C9DC"/><Border Background="#283A4C" HorizontalAlignment="Right" CornerRadius="10" Padding="10,4"><TextBlock Name="TransportText" Text="USB / BLUETOOTH" FontSize="9" Foreground="#8BDDD5"/></Border></Grid>
        <Grid Grid.Row="1" Height="290" Margin="0,12,0,4">
         <Ellipse Width="310" Height="160" Fill="#3446B4B5" VerticalAlignment="Center"><Ellipse.Effect><BlurEffect Radius="65"/></Ellipse.Effect></Ellipse>
         <Image Name="ControllerImage" Stretch="Uniform" Margin="0,0,0,0"/>
        </Grid>
        <StackPanel Grid.Row="2" HorizontalAlignment="Center"><TextBlock Name="ConnectionTitle" Text="Vamos conectar seu controle" FontSize="21" FontWeight="SemiBold" TextAlignment="Center"/><TextBlock Name="ConnectionStatus" Text="Procurando DualShock 4…" Foreground="{StaticResource Muted}" FontSize="12" TextAlignment="Center" Margin="0,8,0,0"/></StackPanel>
        <Grid Grid.Row="3" Margin="0,22,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button Name="ToggleButton" Content="Ativar touchpad" Background="#70E5D6" Foreground="#102B30" FontWeight="SemiBold" FontSize="15"/><Button Name="ReconnectButton" Grid.Column="1" Content="Reconectar" Margin="12,0,0,0"/></Grid>
       </Grid>
      </Border>
      <Border Style="{StaticResource Card}" Padding="22,18" Margin="0,18,0,0">
       <StackPanel><TextBlock Text="UM TOQUE É TUDO O QUE VOCÊ PRECISA" FontSize="10" Foreground="#8DA8BF" Margin="0,0,0,14"/>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
         <StackPanel><TextBlock Text="01 / MOVER" FontSize="10" Foreground="#84E8D9"/><TextBlock Text="Deslize o dedo" FontSize="12" Margin="0,5,0,0"/></StackPanel>
         <StackPanel Grid.Column="1"><TextBlock Text="02 / CLICAR" FontSize="10" Foreground="#84E8D9"/><TextBlock Text="Toque rápido" FontSize="12" Margin="0,5,0,0"/></StackPanel>
         <StackPanel Grid.Column="2"><TextBlock Text="03 / ROLAR" FontSize="10" Foreground="#84E8D9"/><TextBlock Text="Use dois dedos" FontSize="12" Margin="0,5,0,0"/></StackPanel>
        </Grid>
       </StackPanel>
      </Border>
     </StackPanel>
     <StackPanel Grid.Column="2">
      <Border Style="{StaticResource Card}"><StackPanel>
       <Grid><TextBlock Text="Movimento" FontSize="19" FontWeight="SemiBold"/><Button Name="ResetButton" Content="Restaurar" HorizontalAlignment="Right" Padding="10,5" FontSize="11"/></Grid>
       <TextBlock Text="Encontre o ritmo que combina com você." FontSize="12" Foreground="{StaticResource Muted}" Margin="0,7,0,23"/>
       <Grid><TextBlock Text="Sensibilidade"/><TextBlock Name="SensValue" Text="1,0×" Foreground="#80EBDD" HorizontalAlignment="Right" FontWeight="SemiBold"/></Grid>
       <Slider Name="SensitivitySlider" Minimum="0.2" Maximum="3" TickFrequency="0.1" Value="1"/>
       <Grid><TextBlock Text="Mais precisão" Foreground="#8197AF" FontSize="10"/><TextBlock Text="Mais alcance" Foreground="#8197AF" FontSize="10" HorizontalAlignment="Right"/></Grid>
       <Grid Margin="0,24,0,0"><TextBlock Text="Velocidade em gestos rápidos"/><TextBlock Name="SpeedValue" Text="+0%" Foreground="#80EBDD" HorizontalAlignment="Right" FontWeight="SemiBold"/></Grid>
       <Slider Name="SpeedSlider" Minimum="0" Maximum="200" TickFrequency="10" Value="0"/>
       <TextBlock Text="Acelere gestos rápidos sem perder a precisão dos movimentos lentos." FontSize="11" Foreground="{StaticResource Muted}" Margin="0,5,0,0"/>
       <Border Background="#173CDCC4" BorderBrush="#254FD4C2" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,20,0,0"><TextBlock Text="Só o PS4 é ajustado. Seu mouse continua com as mesmas configurações." FontSize="11" Foreground="#91DDD0"/></Border>
      </StackPanel></Border>
      <Border Style="{StaticResource Card}" Margin="0,18,0,0" Padding="24,18"><StackPanel>
       <TextBlock Text="Gestos e preferências" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,8"/>
       <CheckBox Name="TapCheck" Content="Toque para clicar" IsChecked="True"/>
       <CheckBox Name="ScrollCheck" Content="Rolagem com dois dedos" IsChecked="True"/>
       <CheckBox Name="TrayCheck" Content="Manter ativo ao fechar a janela" IsChecked="True"/>
       <TextBlock Text="L1 + toque ou clique = botão direito" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,11,0,0"/>
      </StackPanel></Border>
     </StackPanel>
    </Grid>
    <Grid Margin="2,22,2,0"><TextBlock Name="FooterStatus" Text="Pronto para conectar. Ajustes salvos automaticamente." Foreground="#8197AF" FontSize="11" VerticalAlignment="Center"/><Button Name="ExitButton" Content="Encerrar aplicativo" HorizontalAlignment="Right" Padding="12,7" FontSize="11" Background="Transparent"/></Grid>
   </StackPanel>
  </ScrollViewer>
 </Grid>
</Window>
